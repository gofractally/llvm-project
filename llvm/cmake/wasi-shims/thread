// <thread> shim for LLVM built against no-threads libc++.
//
// libc++'s real <thread> emits #error when threads are off. We
// substitute a compile-only stub for std::thread and std::this_thread.
// In no-threads builds these types are only named as template arguments
// or as placeholder members; runtime calls are guarded by
// LLVM_ENABLE_THREADS upstream.

#ifndef PSI_WASI_SHIMS_THREAD_H
#define PSI_WASI_SHIMS_THREAD_H

#include <__config>

#if defined(_LIBCPP_HAS_NO_THREADS)
#  define _PSI_WASI_SHIM_NO_THREADS 1
#elif defined(_LIBCPP_HAS_THREADS) && (_LIBCPP_HAS_THREADS == 0)
#  define _PSI_WASI_SHIM_NO_THREADS 1
#else
#  define _PSI_WASI_SHIM_NO_THREADS 0
#endif

#if !_PSI_WASI_SHIM_NO_THREADS

#include_next <thread>

#else

#include <chrono>
#include <cstddef>

_LIBCPP_BEGIN_NAMESPACE_STD

class thread {
public:
   class id {
      unsigned long __value_ = 0;
   public:
      id() noexcept = default;
      friend bool operator==(id __a, id __b) noexcept { return __a.__value_ == __b.__value_; }
      friend bool operator!=(id __a, id __b) noexcept { return !(__a == __b); }
      friend bool operator< (id __a, id __b) noexcept { return __a.__value_ <  __b.__value_; }
      friend bool operator<=(id __a, id __b) noexcept { return __a.__value_ <= __b.__value_; }
      friend bool operator> (id __a, id __b) noexcept { return __a.__value_ >  __b.__value_; }
      friend bool operator>=(id __a, id __b) noexcept { return __a.__value_ >= __b.__value_; }
   };
   using native_handle_type = unsigned long;

   thread() noexcept = default;
   template <class _Fn, class... _Args>
   explicit thread(_Fn&&, _Args&&...) noexcept {}
   ~thread() = default;

   thread(const thread&)            = delete;
   thread& operator=(const thread&) = delete;

   thread(thread&&) noexcept = default;
   thread& operator=(thread&&) noexcept = default;

   bool joinable() const noexcept { return false; }
   void join() {}
   void detach() {}
   id get_id() const noexcept { return {}; }
   native_handle_type native_handle() { return 0; }
   static unsigned hardware_concurrency() noexcept { return 1; }

   void swap(thread&) noexcept {}
};

namespace this_thread {

inline thread::id get_id() noexcept { return {}; }
inline void yield() noexcept {}

template <class _Rep, class _Period>
inline void sleep_for(const chrono::duration<_Rep, _Period>&) noexcept {}

template <class _Clock, class _Duration>
inline void sleep_until(const chrono::time_point<_Clock, _Duration>&) noexcept {}

} // namespace this_thread

_LIBCPP_END_NAMESPACE_STD

#endif // _PSI_WASI_SHIM_NO_THREADS

#endif // PSI_WASI_SHIMS_THREAD_H
