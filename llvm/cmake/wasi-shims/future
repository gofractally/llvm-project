// <future> shim for LLVM built against no-threads libc++.
//
// libc++'s <future> transitively #includes <thread>, which hard #errors
// under _LIBCPP_HAS_NO_THREADS. The shim provides compile-only stubs
// sufficient for LLVM to declare std::shared_future / std::future return
// types and std::async call expressions. None of these stubs are ever
// invoked at runtime — every call site in LLVM is gated on
// LLVM_ENABLE_THREADS and dead in our wasi build.

#ifndef PSI_WASI_SHIMS_FUTURE_H
#define PSI_WASI_SHIMS_FUTURE_H

#include <__config>

#if defined(_LIBCPP_HAS_NO_THREADS)
#  define _PSI_WASI_SHIM_NO_THREADS 1
#elif defined(_LIBCPP_HAS_THREADS) && (_LIBCPP_HAS_THREADS == 0)
#  define _PSI_WASI_SHIM_NO_THREADS 1
#else
#  define _PSI_WASI_SHIM_NO_THREADS 0
#endif

#if !_PSI_WASI_SHIM_NO_THREADS

#include_next <future>

#else

#include <chrono>
#include <exception>

_LIBCPP_BEGIN_NAMESPACE_STD

enum class launch : unsigned {
   async    = 1,
   deferred = 2,
   any      = async | deferred,
};

enum class future_status { ready, timeout, deferred };

// All members are no-ops. Only the types and operations need to exist
// for LLVM's Support library to name them in declarations.
template <class _R> class shared_future;

template <class _R>
class future {
public:
   future() noexcept = default;
   future(const future&) = delete;
   future(future&&) noexcept = default;
   future& operator=(const future&) = delete;
   future& operator=(future&&) noexcept = default;
   ~future() = default;

   shared_future<_R> share() noexcept;

   _R get();
   bool valid() const noexcept { return false; }
   void wait() const noexcept {}
   template <class _Rep, class _Period>
   future_status wait_for(const chrono::duration<_Rep, _Period>&) const noexcept { return future_status::ready; }
   template <class _Clock, class _Duration>
   future_status wait_until(const chrono::time_point<_Clock, _Duration>&) const noexcept { return future_status::ready; }
};

template <>
inline void future<void>::get() {}

template <class _R>
inline _R future<_R>::get() { return _R{}; }

template <class _R>
class shared_future {
public:
   shared_future() noexcept = default;
   shared_future(const shared_future&) = default;
   shared_future(shared_future&&) noexcept = default;
   shared_future(future<_R>&&) noexcept {}
   shared_future& operator=(const shared_future&) = default;
   shared_future& operator=(shared_future&&) noexcept = default;
   ~shared_future() = default;

   _R get() const;
   bool valid() const noexcept { return false; }
   void wait() const noexcept {}
   template <class _Rep, class _Period>
   future_status wait_for(const chrono::duration<_Rep, _Period>&) const noexcept { return future_status::ready; }
   template <class _Clock, class _Duration>
   future_status wait_until(const chrono::time_point<_Clock, _Duration>&) const noexcept { return future_status::ready; }
};

template <>
inline void shared_future<void>::get() const {}

template <class _R>
inline _R shared_future<_R>::get() const { return _R{}; }

template <class _R>
inline shared_future<_R> future<_R>::share() noexcept { return shared_future<_R>(); }

// std::async: return a future<T>. Function is never actually run because
// call sites in LLVM that use this are #if LLVM_ENABLE_THREADS-guarded.
template <class _Fn, class... _Args>
future<decltype(std::declval<_Fn>()(std::declval<_Args>()...))>
async(_Fn&&, _Args&&...) {
   return future<decltype(std::declval<_Fn>()(std::declval<_Args>()...))>{};
}

template <class _Fn, class... _Args>
future<decltype(std::declval<_Fn>()(std::declval<_Args>()...))>
async(launch, _Fn&&, _Args&&...) {
   return future<decltype(std::declval<_Fn>()(std::declval<_Args>()...))>{};
}

_LIBCPP_END_NAMESPACE_STD

#endif // _PSI_WASI_SHIM_NO_THREADS

#endif // PSI_WASI_SHIMS_FUTURE_H
