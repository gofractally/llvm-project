// <mutex> shim for LLVM built against no-threads libc++.
//
// Pure passthrough to the real libc++ <mutex> via #include_next. The real
// header loads cleanly under _LIBCPP_HAS_NO_THREADS — it just omits
// std::mutex / std::recursive_mutex. We add no-op versions afterwards so
// LLVM's struct fields and std::lock_guard<std::mutex> instantiations
// can name the types. Runtime call sites are gated on LLVM_ENABLE_THREADS
// upstream so these no-op methods are never invoked.

#ifndef PSI_WASI_SHIMS_MUTEX_H
#define PSI_WASI_SHIMS_MUTEX_H

#include <__config>

#include_next <mutex>

// _LIBCPP_HAS_NO_THREADS is defined bare (no value) in historical libc++.
// _LIBCPP_HAS_THREADS is always 0 or 1 in modern libc++.
#if defined(_LIBCPP_HAS_NO_THREADS)
#  define _PSI_WASI_SHIM_NO_THREADS 1
#elif defined(_LIBCPP_HAS_THREADS) && (_LIBCPP_HAS_THREADS == 0)
#  define _PSI_WASI_SHIM_NO_THREADS 1
#else
#  define _PSI_WASI_SHIM_NO_THREADS 0
#endif

#if _PSI_WASI_SHIM_NO_THREADS

_LIBCPP_BEGIN_NAMESPACE_STD

class mutex {
public:
   constexpr mutex() noexcept = default;
   ~mutex() = default;
   mutex(const mutex&)            = delete;
   mutex& operator=(const mutex&) = delete;

   void lock() noexcept {}
   bool try_lock() noexcept { return true; }
   void unlock() noexcept {}
};

class recursive_mutex {
public:
   recursive_mutex() noexcept = default;
   ~recursive_mutex() = default;
   recursive_mutex(const recursive_mutex&)            = delete;
   recursive_mutex& operator=(const recursive_mutex&) = delete;

   void lock() noexcept {}
   bool try_lock() noexcept { return true; }
   void unlock() noexcept {}
};

class timed_mutex {
public:
   timed_mutex() noexcept = default;
   ~timed_mutex() = default;
   timed_mutex(const timed_mutex&)            = delete;
   timed_mutex& operator=(const timed_mutex&) = delete;

   void lock() noexcept {}
   bool try_lock() noexcept { return true; }
   void unlock() noexcept {}
};

class recursive_timed_mutex {
public:
   recursive_timed_mutex() noexcept = default;
   ~recursive_timed_mutex() = default;
   recursive_timed_mutex(const recursive_timed_mutex&)            = delete;
   recursive_timed_mutex& operator=(const recursive_timed_mutex&) = delete;

   void lock() noexcept {}
   bool try_lock() noexcept { return true; }
   void unlock() noexcept {}
};

_LIBCPP_END_NAMESPACE_STD

#endif // _PSI_WASI_SHIM_NO_THREADS

#endif // PSI_WASI_SHIMS_MUTEX_H
